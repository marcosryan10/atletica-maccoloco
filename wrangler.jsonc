{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atletica-maccoloco",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "dist/client", "binding": "ASSETS"},
  "d1_databases": [{"binding": "DB", "database_name": "maccoloco-db", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "drizzle"}],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "maccoloco-imagens"}],
  "vars": {"CF_ACCESS_TEAM_DOMAIN": "", "CF_ACCESS_AUD": ""},
  "observability": {"enabled": true, "logs": {"invocation_logs": false}}
}
